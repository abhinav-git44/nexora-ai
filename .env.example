# ---------- Core ----------
APP_ENV=development                       # development | test | production
APP_BASE_URL=http://localhost:3000        # public URL of the web app
API_BASE_URL=http://localhost:3000        # public URL clients use for /api (same origin via Next.js rewrite)
BACKEND_URL=http://localhost:8000         # frontend → backend (server-side rewrite target)
DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora
ANALYTICS_READONLY_DATABASE_URL=          # optional: SELECT-only role for NL→SQL + BI (deployment/sql/readonly_role.sql)
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=nexora                  # docker compose only

# ---------- Security (REQUIRED in production) ----------
JWT_SECRET=                               # 64+ random chars: python -c "import secrets;print(secrets.token_urlsafe(64))"
ENCRYPTION_KEY=                           # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
COOKIE_SECURE=false                       # true behind HTTPS
SUPER_ADMIN_EMAILS=                       # comma-separated emails granted platform-admin on signup
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=14
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=30

# ---------- AI providers (leave empty for labelled demo mode) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=auto                  # auto | anthropic | openai | demo
ANTHROPIC_REFUSAL_FALLBACK=true           # server-side fallback for policy declines (Claude API)
AI_REQUEST_TIMEOUT_S=60
AI_MAX_RETRIES=2
MODEL_CATALOG_PATH=                       # optional JSON overriding model ids/prices/routes
EMBEDDING_PROVIDER=auto                   # auto | openai | local

# ---------- Storage ----------
STORAGE_BACKEND=local                     # local | r2
STORAGE_LOCAL_DIR=./var/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MAX_UPLOAD_MB=20

# ---------- Email ----------
EMAIL_BACKEND=console                     # console | smtp | resend
EMAIL_FROM=NEXORA AI <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# ---------- Billing ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
RAZORPAY_KEY_ID=                          # reserved for the India billing adapter (see MONETISATION_STRATEGY.md)
RAZORPAY_KEY_SECRET=

# ---------- OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---------- Analytics & automation ----------
MIXPANEL_TOKEN=
N8N_BASE_URL=
N8N_API_KEY=

# ---------- Workers ----------
RUN_WORKER_IN_PROCESS=true                # false when running `python -m app.worker.run` separately
