{
 "info": {
  "name": "NEXORA AI API",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Curated API validation suite. Run with Newman: npx newman run tests/postman/nexora.postman_collection.json --env-var base_url=http://localhost:8000"
 },
 "variable": [
  {
   "key": "base_url",
   "value": "http://localhost:8000"
  },
  {
   "key": "access_token",
   "value": ""
  },
  {
   "key": "org_id",
   "value": ""
  },
  {
   "key": "conversation_id",
   "value": ""
  },
  {
   "key": "agent_id",
   "value": ""
  },
  {
   "key": "workflow_id",
   "value": ""
